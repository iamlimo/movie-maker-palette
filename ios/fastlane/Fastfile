default_platform(:ios)

platform :ios do
  desc "Build and upload a new App Store release"
  lane :release do
    # Prefer any checked-in AuthKey file (e.g. AuthKey_JU8UAQT8UV.p8), fall back to ENV
    key_path = Dir.glob("AuthKey*.p8").find { |p| File.exist?(p) }
    key_content = ENV['APP_STORE_CONNECT_KEY'] || (key_path ? File.read(key_path) : nil)

    # Try to use provided env vars, otherwise attempt to extract key_id from filename (AuthKey_<KEYID>.p8)
    key_id = ENV['APP_STORE_CONNECT_KEY_ID'] || (key_path && File.basename(key_path).match(/AuthKey_(.+)\.p8/)&.captures&.first)
    issuer_id = ENV['APP_STORE_CONNECT_ISSUER_ID']

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content
    )

    # Resolve workspace path relative to the fastlane directory to avoid
    # issues with runner working directories. Fastfile lives in ios/fastlane.
    fastlane_dir = File.expand_path(File.dirname(__FILE__))
    workspace_env = ENV['XCODE_WORKSPACE']
    workspace_path = if workspace_env && !workspace_env.empty?
      File.expand_path(workspace_env, fastlane_dir)
    else
      File.expand_path('../App/App.xcworkspace', fastlane_dir)
    end

    build_opts = {
      workspace: workspace_path,
      scheme: ENV['XCODE_SCHEME'] || "App",
      export_method: "app-store",
      clean: true
    }

    # If FASTLANE_USER/FASTLANE_PASSWORD are provided, allow Xcode to request
    # provisioning updates on the runner. Also include team ID if supplied.
    if ENV['FASTLANE_USER'] && ENV['FASTLANE_PASSWORD']
      build_opts[:xcargs] = "-allowProvisioningUpdates"
    end

    if ENV['APP_STORE_TEAM_ID'] && !ENV['APP_STORE_TEAM_ID'].empty?
      build_opts[:export_team_id] = ENV['APP_STORE_TEAM_ID']
    end

    # Optional: use fastlane `match` to sync certificates/profiles from a secure
    # git repo. CI should set `MATCH_GIT_URL` and `MATCH_PASSWORD` for this to run.
    if ENV['MATCH_GIT_URL'] && ENV['MATCH_PASSWORD']
      match(
        type: "appstore",
        git_url: ENV['MATCH_GIT_URL'],
        readonly: false,
        username: ENV['FASTLANE_USER']
      )
    else
      UI.message("Skipping match: set MATCH_GIT_URL and MATCH_PASSWORD to enable automatic provisioning sync")
    end

    build_app(**build_opts)

    upload_to_app_store(api_key: api_key)
  end
end
